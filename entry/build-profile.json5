{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      // 带 x86_64：模拟器镜像是 x86_64，只有 arm64 的 .so 装不上（9568347）
      "abiFilters": ["arm64-v8a", "x86_64"],
      "arguments": "",
      "cppFlags": ""
    },
    "resOptions": {
      "copyCodeResource": {
        "enable": true
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "default",
      "arkOptions": {}
    },
    {
      "name": "release",
      "arkOptions": {}
    }
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest"
    }
  ]
}
